# Enforce correct runtime versions (fails fast if Node/pnpm mismatch)
engine-strict=true

# Reproducible installs: never silently update the lockfile
# (prevents supply-chain drift; important for CI and code review)
prefer-frozen-lockfile=true

# Strict node_modules isolation — no phantom dependencies
# Packages can only import what they declare in their own package.json
shamefully-hoist=false

# Peer dependency warnings are treated as errors
# Set to false because Tailwind v4 may emit peer-dep notices
strict-peer-dependencies=false

# Fail pnpm audit on moderate or higher severity vulnerabilities
audit-level=moderate

# Disable telemetry / analytics
update-notifier=false
